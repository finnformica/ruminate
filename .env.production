# Public build-time config for the frontend.
#
# Vite inlines VITE_* variables into the client bundle at build time, so this
# must be present when `npm run build` runs (e.g. on Cloudflare Workers Builds).
# The GitHub OAuth client id is public — it ships in the client bundle either
# way — so it's safe to commit here. The client SECRET is never in the repo;
# it's a Worker secret (`wrangler secret put GITHUB_CLIENT_SECRET`).
VITE_GITHUB_CLIENT_ID=Ov23lidqIncQ8ul67fUo

# Image uploads (docs/images.md). Vite inlines this into the client bundle, so
# it must be here for Workers Builds; the Worker's matching runtime variable is
# in wrangler.jsonc `vars`. Both must be "true" for pictures to work.
VITE_IMAGES_ENABLED=true
