{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruminate",
  "compatibility_date": "2026-08-20",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these routes invoke the Worker; everything else is served straight
    // from static assets (with index.html as the SPA fallback).
    "run_worker_first": [
      "/github-auth",
      "/github-refresh",
      "/file-proxy",
      "/share/*",
      "/api/replica/*",
    ],
  },
  // The one database: the control plane (users + allowlist,
  // docs/multi-tenant-design.md §3) AND every user's corpus, scoped by the
  // `user_id` column (migrations/0004_tenant_columns.sql). Only
  // worker/tenancy-db.ts may touch this binding — `npm run check:queries`
  // fails the build otherwise. Migrations live in ./migrations and are applied
  // with
  //   npx wrangler d1 migrations apply ruminate --local   (dev)
  //   npx wrangler d1 migrations apply ruminate --remote  (production)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruminate",
      "database_id": "7bf20efd-53cd-4605-b0b6-8805a9faab9e",
      "migrations_dir": "./migrations",
    },
  ],
  // Durable Object class migrations. Tags are a cumulative, ordered ledger:
  // every tag ever applied stays in this array (the platform applies the ones
  // it has not seen), so `v1` remains even though the class it created is now
  // gone. `v2` deletes `UserCorpus` (worker/corpus-do.ts, deleted): the corpus
  // lives in D1 scoped by `user_id`, nothing reads a DO any more, and the
  // binding is gone with the class.
  //
  // THIS IS IRREVERSIBLE. `deleted_classes` deletes every object's STORAGE
  // along with the class — there is no trash and no undelete. Do not deploy
  // until every live corpus has been imported into D1 and verified.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserCorpus"] },
    { "tag": "v2", "deleted_classes": ["UserCorpus"] },
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // The GitHub OAuth client id is public (it's already baked into the frontend
  // bundle). The client secret is NOT here — set it once with
  //   npx wrangler secret put GITHUB_CLIENT_SECRET
  // and put both in .dev.vars (git-ignored) for local `wrangler dev`.
  "vars": {
    "VITE_GITHUB_CLIENT_ID": "Ov23lidqIncQ8ul67fUo",
    // Bootstrap owner id: implicit allowlist entry, and the fail-closed
    // fallback if the control-plane migration hasn't run.
    "ALLOWED_GITHUB_ID": "42536816",
    // Signup gate (worker/handlers/tenancy.ts): "allowlist" admits only ids in
    // the control plane's allowlist table (plus the bootstrap owner); "open"
    // auto-provisions any verified GitHub id; absent = bootstrap owner only.
    "SIGNUP_MODE": "open",
  },
}
