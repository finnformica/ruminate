{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruminate",
  "compatibility_date": "2026-08-20",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these routes invoke the Worker; everything else is served straight
    // from static assets (with index.html as the SPA fallback).
    "run_worker_first": [
      "/github-auth",
      "/github-refresh",
      "/file-proxy",
      "/share/*",
      "/api/replica/*",
      "/api/admin/*",
    ],
  },
  // The control-plane database: users + allowlist (docs/multi-tenant-design.md
  // §3), plus the legacy pre-multi-tenant corpus rows until the tenant-#1
  // migration has soaked. Migrations live in ./migrations and are applied with
  //   npx wrangler d1 migrations apply ruminate --local   (dev)
  //   npx wrangler d1 migrations apply ruminate --remote  (production)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruminate",
      "database_id": "7bf20efd-53cd-4605-b0b6-8805a9faab9e",
      "migrations_dir": "./migrations",
    },
  ],
  // One SQLite-backed Durable Object per user holds that user's corpus
  // (docs/multi-tenant-design.md §4; worker/corpus-do.ts). Wrangler has no SQL
  // migration runner for DOs — the class applies the same ./migrations ladder
  // itself in its constructor (src/data/corpus-schema.ts).
  "durable_objects": {
    "bindings": [{ "name": "CORPUS", "class_name": "UserCorpus" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserCorpus"] }],
  // Lets the DO import the ./migrations/*.sql files as strings — the worker
  // bundle's equivalent of the Vite `?raw` import the local store uses on the
  // very same files.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // The GitHub OAuth client id is public (it's already baked into the frontend
  // bundle). The client secret is NOT here — set it once with
  //   npx wrangler secret put GITHUB_CLIENT_SECRET
  // and put both in .dev.vars (git-ignored) for local `wrangler dev`.
  "vars": {
    "VITE_GITHUB_CLIENT_ID": "Ov23lidqIncQ8ul67fUo",
    // Bootstrap owner id: implicit allowlist entry, /api/admin/* gate, and the
    // fail-closed fallback if the control-plane migration hasn't run.
    "ALLOWED_GITHUB_ID": "42536816",
    // Signup gate (worker/handlers/tenancy.ts): "allowlist" admits only ids in
    // the control plane's allowlist table (plus the bootstrap owner); "open"
    // auto-provisions any verified GitHub id; absent = bootstrap owner only.
    "SIGNUP_MODE": "allowlist",
  },
  // Pre-merge testing worker for changes that need FULL deploy semantics
  // (version-upload previews cannot create Durable Object classes):
  //   npx wrangler deploy --env preview   →  ruminate-preview.<acct>.workers.dev
  // Bindings are not inherited by named environments, so the data plane is
  // redeclared: SAME control-plane D1 (reads are safe; the corpus import is
  // read-only on it), but its OWN Durable Objects — corpus writes on the
  // preview worker never touch production data. Needs GITHUB_CLIENT_SECRET
  // set once on this worker (npx wrangler secret put GITHUB_CLIENT_SECRET
  // --env preview) and the preview host registered as an OAuth callback.
  "env": {
    "preview": {
      "assets": {
        "directory": "./dist/",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/github-auth",
          "/github-refresh",
          "/file-proxy",
          "/share/*",
          "/api/replica/*",
          "/api/admin/*",
        ],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ruminate",
          "database_id": "7bf20efd-53cd-4605-b0b6-8805a9faab9e",
          "migrations_dir": "./migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "CORPUS", "class_name": "UserCorpus" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserCorpus"] }],
      "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
      "workers_dev": true,
      "observability": { "enabled": true },
      "vars": {
        "VITE_GITHUB_CLIENT_ID": "Ov23lidqIncQ8ul67fUo",
        "ALLOWED_GITHUB_ID": "42536816",
        "SIGNUP_MODE": "allowlist",
      },
    },
  },
}
