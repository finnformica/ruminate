{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruminate",
  "compatibility_date": "2026-08-20",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these routes invoke the Worker; everything else is served straight
    // from static assets (with index.html as the SPA fallback).
    "run_worker_first": [
      "/github-auth",
      "/github-refresh",
      "/api/replica/*",
      "/api/images",
      "/api/images/*",
      // The MCP endpoint agents POST to, and the session-authed routes the
      // settings page mints and revokes their tokens through
      // (docs/mcp-server.md).
      "/mcp",
      "/api/mcp/tokens",
      "/api/mcp/tokens/*",
    ],
  },
  // The one database: the control plane (users + allowlist,
  // docs/multi-tenant-design.md §3) AND every user's corpus, scoped by the
  // `user_id` column (migrations/0004_tenant_columns.sql). Only
  // worker/tenancy-db.ts may touch this binding — `npm run check:queries`
  // fails the build otherwise. Migrations live in ./migrations:
  //   npx wrangler d1 migrations apply ruminate --local   (dev)
  //   npm run migrate:remote                              (production)
  //
  // Production migrations run as part of `npm run deploy`, BEFORE
  // `wrangler deploy`, and a failure aborts the deploy. That ordering is not
  // cosmetic: Workers Builds ships on merge, so code that reads a new column
  // can reach production minutes before a human remembers to create it. On
  // 2026-09-09 migration 0005 was applied with about four minutes to spare.
  //
  // The ordering is only safe for ADDITIVE migrations — new columns, new
  // indexes, new tables — because between migrate and deploy the OLD code
  // runs against the NEW schema. Anything destructive (dropping or renaming a
  // column live code still reads) has to be split across two deploys: expand,
  // ship the code that stops using it, then contract.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ruminate",
      "database_id": "7bf20efd-53cd-4605-b0b6-8805a9faab9e",
      "migrations_dir": "./migrations",
    },
  ],
  // Durable Object class migrations. Tags are a cumulative, ordered ledger:
  // every tag ever applied stays in this array (the platform applies the ones
  // it has not seen), so `v1` remains even though the class it created is now
  // gone. `v2` deletes `UserCorpus` (worker/corpus-do.ts, deleted): the corpus
  // lives in D1 scoped by `user_id`, nothing reads a DO any more, and the
  // binding is gone with the class.
  //
  // THIS IS IRREVERSIBLE. `deleted_classes` deletes every object's STORAGE
  // along with the class — there is no trash and no undelete. Do not deploy
  // until every live corpus has been imported into D1 and verified.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["UserCorpus"] },
    { "tag": "v2", "deleted_classes": ["UserCorpus"] },
  ],
  // Image uploads (docs/images.md). ON: the bucket exists, this binding names
  // it, and VITE_IMAGES_ENABLED is "true" both here (the Worker reads it at
  // runtime) and in .env.production (Vite inlines it into the client bundle at
  // build time). Both halves must agree — with the client half off, pasting a
  // picture does nothing; with the Worker half off, an upload is refused.
  //
  // The bucket must exist before a deploy carries this binding, or the deploy
  // fails on a binding that names nothing: `npx wrangler r2 bucket create
  // ruminate-images`.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "ruminate-images" }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // The GitHub OAuth client id is public (it's already baked into the frontend
  // bundle). The client secret is NOT here — set it once with
  //   npx wrangler secret put GITHUB_CLIENT_SECRET
  // and put both in .dev.vars (git-ignored) for local `wrangler dev`.
  "vars": {
    "VITE_GITHUB_CLIENT_ID": "Ov23lidqIncQ8ul67fUo",
    // Bootstrap owner id: implicit allowlist entry, and the fail-closed
    // fallback if the control-plane migration hasn't run.
    "ALLOWED_GITHUB_ID": "42536816",
    // Signup gate (worker/handlers/tenancy.ts): "allowlist" admits only ids in
    // the control plane's allowlist table (plus the bootstrap owner); "open"
    // auto-provisions any verified GitHub id; absent = bootstrap owner only.
    //
    // Closed 2026-09-08. Under "open" three ids other than the owner
    // provisioned themselves within a week — invited or not, an open door on a
    // personal instance spends a shared quota: D1's free-tier limits are per
    // ACCOUNT, not per tenant, so any tenant's corpus competes with the
    // owner's 5M daily reads.
    //
    // This gates NEW ids only. `resolveTenancy` answers from the `users` table
    // before it ever consults the mode, so every id already provisioned keeps
    // its access — closing signups is not a revocation. Revoking is
    // `UPDATE users SET status = 'blocked'`, deliberately a separate act.
    "SIGNUP_MODE": "allowlist",
    // Image uploads: the Worker's half of the switch (the client's half is the
    // same variable in .env.production). Both are "true"; see the binding above.
    "VITE_IMAGES_ENABLED": "true",
  },
}
