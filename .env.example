# Frontend build-time vars (Vite inlines VITE_* into the client bundle).
# Copy to .env for local development.
#
# The Worker's server-side vars/secrets live separately in .dev.vars
# (see .dev.vars.example) and in Cloudflare for production.

# A GitHub personal access token to sign in during local dev (skips OAuth).
VITE_GITHUB_PAT=

# Your GitHub OAuth app's public client id (used for the production OAuth flow).
VITE_GITHUB_CLIENT_ID=

# Image uploads (docs/images.md). "true" lets the editor accept pasted or
# dropped pictures and upload them to R2 through the Worker; anything else
# (or unset) leaves the feature off — pasting an image does nothing. Must
# match the Worker's variable of the same name in wrangler.jsonc.
VITE_IMAGES_ENABLED=false
