{
  "name": "ruminate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "npm run build && wrangler dev",
    "dev:storybook": "storybook dev -p 6006",
    "build": "tsc && vite build",
    "build:storybook": "storybook build",
    "preview": "vite preview",
    "migrate:remote": "wrangler d1 migrations apply ruminate --remote",
    "preview:deploy": "node scripts/preview-deploy.mjs",
    "deploy": "npm run build && npm run migrate:remote && wrangler deploy",
    "check:worker": "tsc -p worker/tsconfig.json",
    "check:queries": "vite-node scripts/check-queries.ts",
    "knip": "knip --no-config-hints",
    "format": "prettier --write .",
    "lint": "eslint --ext .js,.ts,.tsx src worker scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "test-storybook",
    "test:storybook:watch": "test-storybook --watch",
    "test:storybook:ci": "concurrently -k -s first -n \"storybook,test\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && npm run test:storybook\"",
    "test:e2e": "concurrently -k -s first -n \"storybook,e2e\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6010 --silent\" \"npx wait-on tcp:127.0.0.1:6010 && node e2e/block-editor.e2e.mjs e2e/__screenshots__\"",
    "test:fold": "concurrently -k -s first -n \"storybook,fold\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6012 --silent\" \"npx wait-on tcp:127.0.0.1:6012 && node e2e/fold-motion.e2e.mjs\"",
    "test:select": "concurrently -k -s first -n \"storybook,select\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6013 --silent\" \"npx wait-on tcp:127.0.0.1:6013 && node e2e/multi-select.e2e.mjs\"",
    "test:vr": "concurrently -k -s first -n \"storybook,vr\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6011 --silent\" \"npx wait-on tcp:127.0.0.1:6011 && node e2e/visual-regression.mjs --check\"",
    "test:vr:update": "concurrently -k -s first -n \"storybook,vr\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6011 --silent\" \"npx wait-on tcp:127.0.0.1:6011 && node e2e/visual-regression.mjs --update\"",
    "postinstall": "patch-package",
    "test:vr:accept": "node e2e/vr-accept.mjs",
    "check:changelog": "vite-node scripts/check-changelog.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource/monaspace-radon": "^5.3.0",
    "@fontsource/monaspace-xenon": "^5.3.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build1",
    "@tanstack/react-router": "^1.170.40",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^0.2.1",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "^4.4.0",
    "fast-fuzzy": "^1.12.0",
    "fractional-indexing": "^4.0.0",
    "jotai": "^2.20.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.6.2",
    "react-intersection-observer": "^11.0.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "react-use": "^17.6.1",
    "refractor": "^5.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "thumbhash": "^0.1.1",
    "unified": "^11.0.5",
    "urlcat": "^3.1.0",
    "use-debounce": "^10.1.1",
    "use-resize-observer": "^9.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.20.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.41",
    "@testing-library/react": "^16.3.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "^10.6.0",
    "http-server": "^14.1.1",
    "jotai-babel": "^0.3.0",
    "jsdom": "30.0.1",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.38.0",
    "patch-package": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^5.14.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-node": "^5.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "wait-on": "^7.2.0",
    "workbox-window": "^7.1.0",
    "wrangler": "^4.143.0"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "printWidth": 100
  },
  "engines": {
    "cloudflare": "*"
  }
}
