{
  "name": "ruminate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:worker": "npm run build && wrangler dev",
    "dev:storybook": "storybook dev -p 6006",
    "build": "tsc && vite build",
    "build:storybook": "storybook build",
    "preview": "vite preview",
    "migrate:remote": "wrangler d1 migrations apply ruminate --remote",
    "deploy": "npm run build && npm run migrate:remote && wrangler deploy",
    "check:worker": "tsc -p worker/tsconfig.json",
    "check:queries": "vite-node scripts/check-queries.ts",
    "knip": "knip --no-config-hints",
    "format": "prettier --write .",
    "lint": "eslint --ext .js,.ts,.tsx src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:storybook": "test-storybook",
    "test:storybook:watch": "test-storybook --watch",
    "test:storybook:ci": "concurrently -k -s first -n \"storybook,test\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && npm run test:storybook\"",
    "test:e2e": "concurrently -k -s first -n \"storybook,e2e\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6010 --silent\" \"npx wait-on tcp:127.0.0.1:6010 && node e2e/block-editor.e2e.mjs e2e/__screenshots__\"",
    "test:vr": "concurrently -k -s first -n \"storybook,vr\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6011 --silent\" \"npx wait-on tcp:127.0.0.1:6011 && node e2e/visual-regression.mjs --check\"",
    "test:vr:update": "concurrently -k -s first -n \"storybook,vr\" -c \"magenta,blue\" \"npm run build:storybook --quiet && npx http-server storybook-static --port 6011 --silent\" \"npx wait-on tcp:127.0.0.1:6011 && node e2e/visual-regression.mjs --update\"",
    "postinstall": "patch-package",
    "test:vr:accept": "node e2e/vr-accept.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.2.5",
    "@fontsource/monaspace-radon": "^5.2.5",
    "@fontsource/monaspace-xenon": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.0.0",
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@tanstack/react-router": "^1.112.18",
    "chrono-node": "^2.10.1",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.0",
    "copy-to-clipboard": "^4.0.2",
    "date-fns": "^4.1.0",
    "emoji-regex": "^10.4.0",
    "fast-fuzzy": "^1.11.2",
    "fractional-indexing": "^4.0.0",
    "jotai": "^2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^4.5.0",
    "react-intersection-observer": "^9.4.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.2",
    "react-use": "^17.6.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.2.1",
    "unified": "^11.0.5",
    "urlcat": "^3.1.0",
    "use-debounce": "^10.0.4",
    "use-resize-observer": "^9.1.0",
    "vaul": "^1.1.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/test": "^8.4.7",
    "@storybook/test-runner": "^0.20.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.113.0",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/mdast": "^3.0.10",
    "@types/node": "^25.0.3",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "eslint": "^8.54.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.5.10",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "knip": "^6.33.0",
    "patch-package": "^6.4.7",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^5.12.0",
    "storybook": "^8.4.7",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-node": "^5.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0",
    "wait-on": "^7.0.1",
    "workbox-window": "^7.1.0",
    "wrangler": "^4.0.0"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "all",
    "printWidth": 100
  },
  "engines": {
    "cloudflare": "*"
  }
}
